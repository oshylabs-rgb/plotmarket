# Copy to .env.local and fill in. Never commit the filled in file.

# Supabase, project settings then API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server only, bypasses row level security, never expose it
# to the browser and never prefix it with NEXT_PUBLIC_.
# Required by the Paystack webhook and callback: those run without a visitor
# session, so an anon key client is blocked by row level security and a paid
# for subscription is silently never granted.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack, dashboard then settings then API keys and webhooks
PAYSTACK_SECRET_KEY=

# Public origin, used to build Paystack callback URLs.
# Must be the real origin in production or checkout returns to localhost.
NEXT_PUBLIC_APP_URL=https://plotmarket.ng
